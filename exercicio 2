#include <stdio.h>

int main()
{
    int valor, resto;
    // estoque do caixa de cada nota
    int e200, e100, e50, e20, e10, e5;
    // quantidade de notas que podem ser usadas (estoque - 1, pois 1 de cada deve ser preservada)
    int d200, d100, d50, d20, d10, d5;
    // quantidade entregue de cada nota
    int q200, q100, q50, q20, q10, q5;
    int total;

    printf("Informe o estoque do caixa (quantidade de notas)\n");
    printf("R$ 200: "); scanf("%d", &e200);
    printf("R$ 100: "); scanf("%d", &e100);
    printf("R$ 50: ");  scanf("%d", &e50);
    printf("R$ 20: ");  scanf("%d", &e20);
    printf("R$ 10: ");  scanf("%d", &e10);
    printf("R$ 5: ");   scanf("%d", &e5);

    printf("\nValor do saque: R$ ");
    scanf("%d", &valor);

    // 1) Validacao do valor
    if (valor <= 0)
    {
        printf("Valor invalido: deve ser maior que zero\n");
        return 0;
    }
    if (valor % 5 != 0)
    {
        printf("Valor invalido: nao ha notas para formar esse valor (use multiplos de 5)\n");
        return 0;
    }

    // 2) Notas disponiveis para saque (preserva pelo menos 1 de cada)
    d200 = (e200 > 1) ? e200 - 1 : 0;
    d100 = (e100 > 1) ? e100 - 1 : 0;
    d50  = (e50  > 1) ? e50  - 1 : 0;
    d20  = (e20  > 1) ? e20  - 1 : 0;
    d10  = (e10  > 1) ? e10  - 1 : 0;
    d5   = (e5   > 1) ? e5   - 1 : 0;

    // 3) Algoritmo guloso: usa o maximo possivel da maior nota, respeitando o limite
    resto = valor;

    q200 = resto / 200; if (q200 > d200) q200 = d200; resto -= q200 * 200;
    q100 = resto / 100; if (q100 > d100) q100 = d100; resto -= q100 * 100;
    q50  = resto / 50;  if (q50  > d50)  q50  = d50;  resto -= q50  * 50;
    q20  = resto / 20;  if (q20  > d20)  q20  = d20;  resto -= q20  * 20;
    q10  = resto / 10;  if (q10  > d10)  q10  = d10;  resto -= q10  * 10;
    q5   = resto / 5;   if (q5   > d5)   q5   = d5;   resto -= q5   * 5;

    // 4) Se sobrou resto, nao foi possivel sacar sem violar a regra
    if (resto != 0)
    {
        printf("\nSaque NAO realizado: nao e possivel pagar R$ %d preservando\n", valor);
        printf("pelo menos uma nota de cada denominacao no caixa.\n");
    }
    else
    {
        total = q200 + q100 + q50 + q20 + q10 + q5;

        printf("\nSaque de R$ %d realizado! Notas entregues:\n", valor);
        if (q200 > 0) printf("%d nota(s) de R$ 200\n", q200);
        if (q100 > 0) printf("%d nota(s) de R$ 100\n", q100);
        if (q50  > 0) printf("%d nota(s) de R$ 50\n",  q50);
        if (q20  > 0) printf("%d nota(s) de R$ 20\n",  q20);
        if (q10  > 0) printf("%d nota(s) de R$ 10\n",  q10);
        if (q5   > 0) printf("%d nota(s) de R$ 5\n",   q5);
        printf("Total de cedulas: %d\n", total);
    }

    return 0;
}
